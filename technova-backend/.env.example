# ============================================================
# TechNova Backend — variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# El .env NUNCA se commitea (ver .gitignore).
# ============================================================

# Cadena de conexión a PostgreSQL.
# Neon / Render exigen SSL → mantené el sufijo ?sslmode=require
# Local sin SSL: postgresql://postgres:postgres@localhost:5432/technova_db
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/NOMBRE_DB?sslmode=require

# Clave para firmar los JWT de sesión. Cadena larga y aleatoria.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-una-cadena-larga-y-aleatoria

# Webhook de n8n que dispara el flujo de recuperación de carritos abandonados.
# n8n local: http://localhost:5678/webhook/carrito-abandonado
N8N_WEBHOOK_URL=http://localhost:5678/webhook/carrito-abandonado

# Token compartido entre el backend y n8n, viaja en la cabecera X-Webhook-Token.
# Protege POST /api/webhook/cart-abandoned y el nodo Webhook de n8n.
# El MISMO valor va en la credencial "Header Auth" de n8n.
# Sin esta variable el endpoint responde 500 y no procesa nada (falla cerrado).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_TOKEN=cambiame-por-una-cadena-larga-y-aleatoria

# Origen del frontend permitido por CORS y base para armar el link de checkout.
FRONTEND_URL=http://localhost:5173

# Puerto donde escucha la API.
PORT=3001

# development | production  (production fuerza SSL en la conexión a la DB)
NODE_ENV=development
